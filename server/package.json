{
  "name": "order-management-backend",
  "version": "1.0.0",
  "description": "Order Management System API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "1.12.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "5.1.0",
    "morgan": "1.10.1",
    "pg": "8.16.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.4",
    "@types/morgan": "1.9.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "eslint": "9.0.0",
    "nodemon": "3.1.0",
    "prettier": "3.0.0",
    "ts-node": "10.9.2",
    "typescript": "^5.6.3"
  }
}